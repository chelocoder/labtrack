@startuml
title LabTrack - Diagrama de casos de uso

left to right direction

skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

actor "Instructor" as Instructor

rectangle "LabTrack" {
    usecase "CU01\nRegistrar práctica" as CU01
    usecase "CU02\nConsultar prácticas" as CU02
    usecase "CU03\nCompletar práctica" as CU03

    CU01 -[hidden]down- CU02
    CU02 -[hidden]down- CU03
}

Instructor -- CU01
Instructor -- CU02
Instructor -- CU03

@enduml
